.env
# Dockerfile делает `COPY . .` — без этой строки пароли PostgreSQL попали бы
# в слой образа web, ровно туда, где их быть не должно.
.env.db
.git
.gitignore
__pycache__
*.pyc
db.sqlite3
data/
.venv
staticfiles/
tokens.txt
# Пароль роли sync_worker (сервис worker) — в образ web не нужен.
.env.worker
