SECRET_KEY=django-insecure-replace-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Заполнять, если приложение открывается по HTTPS (домен/IP с https://)
CSRF_TRUSTED_ORIGINS=https://ip-plan.example.com
# True, только если перед приложением nginx/другой proxy сам выставляет
# X-Forwarded-Proto и не пропускает этот заголовок от клиента напрямую
USE_X_FORWARDED_PROTO=False
# Заполнять, только если приложение открывается под префиксом пути
# (например https://netbox.sicmt.local/ipplan -> URL_PREFIX=/ipplan).
# Пусто — приложение в корне домена (как сейчас на dev).
URL_PREFIX=

# Свои имена куки сессии/CSRF — браузер не различает куки по порту, только
# по домену+пути. Если открывать это приложение и NetBox на одном hostname
# (например localhost, разные порты) с дефолтными именами Django
# ("sessionid"/"csrftoken"), логин в одном тут же разлогинивает другой.
# Менять не обязательно — значения по умолчанию уже уникальны.
# react-суффикс — специально ДРУГОЙ, чем в ip_plan_docker (ipplan_sessionid/
# ipplan_csrftoken): оба стенда открываются на одном hostname (localhost),
# разные порты, а браузер куки по порту не различает — с одинаковыми
# именами логин в одном тут же разлогинивал бы другой.
SESSION_COOKIE_NAME=ipplanreact_sessionid
CSRF_COOKIE_NAME=ipplanreact_csrftoken

NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=your_netbox_api_token_here
NETBOX_VERIFY_SSL=false
NETBOX_TIMEOUT=15

# Фильтрация (опционально)
NETBOX_SITE_FILTER=
NETBOX_TAG_FILTER=

# Сетевые проверки: DNS-серверы для PTR-резолва (через запятую) и regex
# для пропуска "бесполезных" PTR-имён (например, служебных зон).
NETBOX_DNS_SERVERS=10.0.0.1,10.0.0.2
NETBOX_DNS_SKIP_PATTERN=\.vipnet$

# Хостовый (НЕ внутриконтейнерный) путь до корня netbox-sync — используется
# ТОЛЬКО docker-compose.yml для подстановки в volumes (config_backups/ и
# sync_logs/, см. комментарий там), Django его не читает напрямую. Пусто —
# сиблинг-директория ../netbox-sync (подходит для локальной разработки, обе
# директории рядом на диске). На проде — обязательно /opt/scan (DEPLOY_PATH
# из netbox-sync, см. CLAUDE.md): раннер чекаутит проекты НЕ рядом.
NETBOX_SYNC_DIR=

# Страница "ACL": каталог с running-config бэкапами Cisco-устройств
# (netbox-sync/netbox_config_backup.py → config_backups/<device>/latest.cfg).
# Путь ВНУТРИ контейнера — пусто = дефолт, совпадающий с точкой монтирования
# в docker-compose.yml. Задавать только если раскладка внутри контейнера
# отличается от стандартной.
ACL_CONFIG_BACKUPS_DIR=

# Страница "ACL": сети короче этого префикса — «широкие наборы» (свёртка
# внизу результата поиска). Пусто = /16.
ACL_WIDE_PREFIX=

# Раздел "Настройки" (шапка) — сводка последнего прогона netbox-sync. Тот же
# принцип, что и у ACL_CONFIG_BACKUPS_DIR выше — путь внутри контейнера,
# пусто = дефолт.
SYNC_LOGS_DIR=
# Часовой пояс времени в логах full_sync.sh и расписание его cron — для
# «Настройки → Запуск и расписание» (cron живёт на хосте, контейнеру не виден)
SYNC_LOG_TZ=Europe/Moscow
SYNC_SCHEDULE=0 3 * * *

# Блокировки регулятора — снимок объектов блокировки firewall
# (netbox_firewall_blocklist_sync.py), подмешивается в генератор CLI-команд.
# Тот же принцип, путь внутри контейнера, пусто = дефолт.
FIREWALL_BLOCKLISTS_DIR=

# ВНИМАНИЕ: с появлением раздела "Настройки" параметры LDAP (серверы, bind DN
# и пароль, базы поиска, группы) хранятся в БД и правятся в интерфейсе. Эта
# переменная нужна только ОДИН раз — при первом применении миграции
# 0008_seed_ldap_config, которая переносит настройки из
# ip_plan/ldap_settings.json в базу. После этого её значение не читается.
#
# Пароль bind-аккаунта для LDAP (FreeIPA) — имя самой переменной задано в
# ip_plan/ldap_settings.json (bind_password_env_var). Без неё бинд-аккаунт
# логинится с пустым паролем, и LDAP-поиск пользователя падает — это
# выглядит как "неверный пароль" для ЛЮБОГО реального пользователя.
LDAP_BIND_PASSWORD=
# Уровень логирования django_auth_ldap (опционально, по умолчанию WARNING).
# CA-сертификат для LDAPS. Единственный параметр LDAP, который НЕЛЬЗЯ
# поменять из интерфейса: опции TLS в python-ldap глобальны для процесса и
# применяются до первого соединения, поэтому смена требует перезапуска
# контейнера. Пусто — путь берётся из ip_plan/ldap_settings.json.
LDAP_TLS_CA_CERT=

# DEBUG — для диагностики при первой настройке LDAP-бинда/фильтра/группы.
LDAP_LOG_LEVEL=

# --- Локальный (не-LDAP) администратор ---------------------------------
# Аварийный вход на случай, когда LDAP недоступен или настроен неверно:
# entrypoint.sh при старте вызывает `manage.py ensure_local_admin`, который
# создаёт учётку ТОЛЬКО если локальных ещё нет. Повторные старты пароль не
# сбрасывают. При первом входе смена пароля обязательна — до неё
# приложение не пускает никуда, кроме страницы смены.
# Пустые значения = admin/admin.
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=
# false — не создавать локального администратора вообще (например, если
# он уже заведён вручную через `manage.py createsuperuser`).
SEED_LOCAL_ADMIN=

# --- Шлюз удалённого доступа (Apache Guacamole): SSH/RDP/VNC в браузере ---
# Сервисы guacd и guacamole лежат в docker-compose.yml под профилем
# "gateway" и без него не стартуют. Включить шлюз — задать обе строки:
#   COMPOSE_PROFILES=gateway
#   GUACAMOLE_JSON_SECRET_KEY=<32 hex-символа, `openssl rand -hex 16`>
# Ключ общий для ip_plan и контейнера guacamole (compose подставляет его
# туда как JSON_SECRET_KEY). Пусто = шлюз выключен, пунктов «В браузере» в
# меню строки таблицы адресов нет.
COMPOSE_PROFILES=
GUACAMOLE_JSON_SECRET_KEY=
# Куда отправлять браузер пользователя. Пусто = http://localhost:8091/guacamole
# (порт контейнера напрямую, локальный стенд). На проде — адрес location в
# nginx хоста, например https://netbox.sicmt.local/guac
GUACAMOLE_PUBLIC_URL=
# Куда ip_plan ходит сам за токеном. Пусто = http://guacamole:8080/guacamole
GUACAMOLE_INTERNAL_URL=
# false — пускать через шлюз всех вошедших пользователей, а не только staff.
# Шлюз ходит к хостам с адреса сервера, поэтому по умолчанию только staff.
GUACAMOLE_STAFF_ONLY=

# Карта сети: каталог lldp_snapshots внутри контейнера (пусто = /app/lldp_snapshots)
# и адрес NetBox для ссылок из браузера (пусто = NETBOX_URL, host.docker.internal → localhost).
TOPOLOGY_DIR=
NETBOX_PUBLIC_URL=
