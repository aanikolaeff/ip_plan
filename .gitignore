.env
# Секреты PostgreSQL (пароль суперпользователя и ролей) — отдельно от .env,
# см. .env.db.example и сервис postgres в docker-compose.yml.
.env.db
__pycache__/
*.pyc
db.sqlite3
data/
.venv/
staticfiles/
.DS_Store

# React-таблица (docs/plans/2026-09-03-ip-table-react-design.md): node_modules
# ставится через package-lock.json, dist/ собирается заново на каждой сборке
# Docker-образа (см. Dockerfile, стадия frontend-build) — коммитить нечего,
# как и .venv/staticfiles/ выше.
node_modules/
ip_plan/static/ip_plan/dist/

# Реальная переписка с регулятором (письма ФСТЭК, тестовые CSV) — обнаружена
# лежащей прямо в рабочей копии при аудите IOC-парсера (см.
# docs/plans/2026-09-07-ioc-parser-fstec-corpus-audit.md), не файл проекта.
# Не должна попасть в git ни при каком случайном `git add -A`.
FSTEC/

# Пароль роли sync_worker для контейнера worker (docker-compose.yml) — только он.
.env.worker
