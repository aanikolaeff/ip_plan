# Секреты PostgreSQL — ТОЛЬКО для контейнера postgres (env_file в
# docker-compose.yml). Отдельно от .env, потому что .env целиком уходит в
# контейнер web, а веб-приложению пароль суперпользователя и пароль
# владельца netobs не нужны. Скопировать в .env.db и заполнить:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Файл в .gitignore и .dockerignore; на проде его пишет .gitlab-ci.yml из
# CI/CD-переменных с теми же именами.

# --- Суперпользователь postgres -----------------------------------------
# Читается образом ТОЛЬКО при инициализации пустого тома pg_data. Сменить
# потом — `ALTER ROLE postgres PASSWORD ...` вручную; правка этой строки на
# уже созданной базе ничего не меняет. Снаружи контейнера им не пользуются:
# bootstrap.sh ходит через unix-сокет.
POSTGRES_PASSWORD=

# --- Пароли ролей (db/bootstrap.sh) -------------------------------------
# bootstrap.sh выставляет их ролям при каждом запуске — автоматически на
# пустом томе и вручную на существующем:
#   docker compose exec postgres bash /opt/ip_plan_db/bootstrap.sh
# Поэтому смена пароля = правка здесь (и в .env, где он продублирован) +
# ручной запуск bootstrap.sh + перезапуск web.
#
# ip_plan — владелец базы ip_plan (Django). То же значение — в .env как
# IP_PLAN_DB_PASSWORD.
IP_PLAN_DB_PASSWORD=
# netbox_sync — владелец базы netobs, под ним netbox-sync пишет наблюдения и
# применяет миграции схемы. В .env (контейнер web) этого пароля нет и быть
# не должно; netbox-sync берёт его из своего conf/netobs.json.
NETBOX_SYNC_DB_PASSWORD=
# ip_plan_ro — только чтение netobs (поиск MAC/IP). То же значение — в .env
# как NETOBS_RO_PASSWORD.
NETOBS_RO_PASSWORD=
# sync_worker — сборщик netbox-sync (контейнер worker): в базе ip_plan
# только таблицы sync_job и sync_schedule (права — миграция 0012 и
# bootstrap.sh). В .env (контейнер web) этого пароля нет; контейнер worker
# получает его из отдельного .env.worker (одна эта строка, то же значение).
SYNC_WORKER_DB_PASSWORD=
